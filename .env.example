# Copier en .env.local et remplir. Ne JAMAIS committer de vraies valeurs.

# --- Exposées au navigateur (préfixe BUN_PUBLIC_, cf. bunfig.toml) ---
# Uniquement des valeurs publiques : URL du projet et clé « publishable » (protégée par la RLS).
BUN_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
BUN_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Serveur uniquement (api/evaluate-idea, jamais dans le navigateur) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète (Project Settings → API Keys → Secret keys) : écrit les résultats des agents.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Fournisseur d'IA des agents : "simulation" (aucun appel, aucun jeton consommé), "zai" (GLM)
# ou "openrouter". Par défaut : zai si ZAI_API_KEY est défini.
LLM_PROVIDER=simulation

# Z.ai — modèles GLM (https://z.ai/manage-apikey/apikey-list)
ZAI_API_KEY=xxx
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL_ANALYSTE=glm-5.2
ZAI_MODEL_CONSULTANT=glm-5.2
ZAI_MODEL_ASSOCIE=glm-5.2
# « Réflexion » GLM : plus fine mais plus lente et plus coûteuse.
ZAI_THINKING=false

# Limitation de débit vers le fournisseur d'IA (partagée par toutes les évaluations du serveur)
LLM_MAX_CONCURRENT=2
LLM_REQUESTS_PER_MINUTE=20
LLM_MIN_INTERVAL_MS=500
LLM_TIMEOUT_MS=180000
# Quota par utilisateur (évaluations lancées par heure)
EVALUATIONS_PER_HOUR=60
# Quota par utilisateur (messages de discussion avec l'IA par heure)
CHAT_MESSAGES_PER_HOUR=120
# Cache des sorties d'agents : âge maximal d'une entrée réutilisable (jours)
AGENT_CACHE_MAX_AGE_DAYS=90
# Pages web consultées par agent (1 à 10)
WEB_MAX_RESULTS=5

# OpenRouter (https://openrouter.ai/keys) — fixer un plafond de dépense.
OPENROUTER_API_KEY=sk-or-v1-xxx
# Modèle par rôle (facultatif ; valeurs par défaut ci-dessous).
OPENROUTER_MODEL_ANALYSTE=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_CONSULTANT=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_ASSOCIE=anthropic/claude-sonnet-5.5
# Adresse de l'application (transmise à OpenRouter pour identifier l'appelant).
APP_URL=http://localhost:3000

# --- Outillage local (MCP Claude Code, cf. .mcp.json ; à définir comme variables d'environnement système) ---
SUPABASE_ACCESS_TOKEN=sbp_xxx
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx
