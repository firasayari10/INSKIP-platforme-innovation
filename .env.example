# Copier en .env.local et remplir. Ne JAMAIS committer de vraies valeurs.

# --- Exposées au navigateur (préfixe BUN_PUBLIC_, cf. bunfig.toml) ---
# Uniquement des valeurs publiques : URL du projet et clé « publishable » (protégée par la RLS).
BUN_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
BUN_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Serveur uniquement (Vercel Functions, dossier api/) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Outillage local (MCP Claude Code, cf. .mcp.json) ---
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_xxx
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx
